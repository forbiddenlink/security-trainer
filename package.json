{
  "name": "security-trainer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "start": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "downloadjs": "^1.4.7",
    "framer-motion": "^13.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.2",
    "posthog-js": "^1.418.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/downloadjs": "1.4.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "10.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Gamified web-based interactive learning platform for teaching web security vulnerabilities and defensive coding practices",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qwww-vcr4-c8h2"
      ]
    },
    "overrides": {
      "brace-expansion@5": ">=5.0.12 <6",
      "dompurify": ">=3.4.16 <4",
      "flatted": ">=3.4.2 <4",
      "lodash-es": ">=4.18.0 <5",
      "minimatch": ">=9.0.7 <11",
      "picomatch": ">=4.0.4 <5",
      "react-router@8": ">=8.3.0 <9",
      "rollup": ">=4.59.0 <5",
      "undici": ">=7.29.1 <8.0.0",
      "vite": ">=7.3.2 <9",
      "browserslist": ">=4.28.7 <5"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
