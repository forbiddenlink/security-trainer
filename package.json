{
  "name": "security-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "start": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.50",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.110.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "downloadjs": "^1.4.7",
    "edge-tts": "^1.0.1",
    "framer-motion": "^12.42.2",
    "groq-sdk": "^1.3.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "posthog-js": "^1.396.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "xterm": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/downloadjs": "^1.4.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Gamified web-based interactive learning platform for teaching web security vulnerabilities and defensive coding practices",
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "minimatch": ">=9.0.7",
      "dompurify": ">=3.3.2",
      "undici": ">=7.25.0 <8.0.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "lodash-es": ">=4.18.0",
      "vite": ">=7.3.2"
    }
  }
}
