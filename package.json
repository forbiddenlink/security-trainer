{
  "name": "security-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "start": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.39",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.108.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "downloadjs": "^1.4.7",
    "edge-tts": "^1.0.1",
    "framer-motion": "^12.40.0",
    "groq-sdk": "^1.2.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "posthog-js": "^1.382.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "xterm": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/downloadjs": "^1.4.6",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Gamified web-based interactive learning platform for teaching web security vulnerabilities and defensive coding practices",
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "minimatch": ">=9.0.7",
      "dompurify": ">=3.3.2",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "lodash-es": ">=4.18.0",
      "vite": ">=7.3.2"
    }
  }
}
