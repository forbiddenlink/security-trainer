# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PostHog Analytics (free tier: 1M events/mo)
# Get your key at: https://posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Groq AI
# Client-side optional key (legacy feedback helpers) — prefer server key below
VITE_GROQ_API_KEY=
# Server-side key for /api/socratic-hint (Vercel env + local Vite middleware)
GROQ_API_KEY=

# Sentry Error Tracking (free tier: 5K errors/mo)
# Get your DSN at: https://sentry.io
VITE_SENTRY_DSN=

# Socratic hint endpoint rate limiting (api/socratic-hint.ts).
# Set both to enable per-IP throttling via Upstash. On a Vercel deploy the
# endpoint FAILS CLOSED (503) if these are unset, to avoid an open LLM proxy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" to intentionally run the hint endpoint with NO rate limit.
HINTS_ALLOW_NO_RATELIMIT=
